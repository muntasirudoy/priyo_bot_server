PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional for direct cross-origin API calls. The iframe normally calls through the chatbot client origin.
ALLOWED_EMBED_ORIGINS=
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Increment this whenever the embedding model or embedding strategy changes, then reindex all PDFs.
EMBEDDING_VERSION=v1
# Never enable this in production. It exists only for offline development/tests.
ALLOW_FALLBACK_EMBEDDINGS=false
UPLOAD_DIR=uploads
