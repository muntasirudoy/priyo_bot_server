# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave empty to use zero-config embedded MongoDB Memory Server for local dev)
MONGODB_URI=

# Authentication Secret
JWT_SECRET=super_secret_jwt_key_please_change_in_production_998877

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Uploads
UPLOAD_DIR=uploads
